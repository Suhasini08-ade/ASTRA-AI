# ============================================================
# Jarvis AI Voice Assistant — Environment Variables Template
# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real ".env" file to Git.
# ============================================================

# --- AI providers ---
# Use a primary provider and optionally a distinct fallback. A fallback is used
# only for temporary service failures (for example, 429 or 503), never for a
# missing/invalid key or invalid model.
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_FALLBACKS=groq,openrouter

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b

# Legacy optional provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Picovoice Porcupine (Required for Wake Word "Jarvis") ---
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# --- OpenWeatherMap (Required for Weather feature) ---
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
DEFAULT_CITY=Latur

# --- NewsAPI (Required for News feature) ---
NEWS_API_KEY=your_newsapi_key_here

# --- Email (Required for Email feature) ---
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_specific_password_here
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- Assistant Settings ---
WAKE_WORD=jarvis
TTS_RATE=175
TTS_VOICE_GENDER=male

# --- MongoDB Atlas ---
# URL-encode reserved characters in the username/password. For example,
# an @ in a password becomes %40. Do not keep angle brackets in this value.
MONGODB_URI=mongodb+srv://your_username:your_url_encoded_password@cluster0.example.mongodb.net/jarvis?retryWrites=true&w=majority
MONGODB_DB_NAME=jarvis
