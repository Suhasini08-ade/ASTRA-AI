# ============================================================
# ASTRA AI Frontend — Environment Variables Template
# Copy this file to ".env" and fill in your real credentials.
# NEVER commit the real ".env" file to version control.
# ============================================================

# Backend API Base URL
# During local development with the Vite proxy, requests to /api are proxied to http://localhost:8000
VITE_API_BASE_URL=/api

# Firebase Web Client Configuration
# Obtain from Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
